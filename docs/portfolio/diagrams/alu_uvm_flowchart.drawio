<mxfile host="app.diagrams.net" agent="dgm.py" version="24.0.0">
<diagram id="uvm-run-flow-of-the-alu-test-(phases-and-sequences)" name="UVM run flow of the ALU test (phases and sequences)">
<mxGraphModel dx="1100" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1050" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="b" value="&lt;b&gt;build_phase&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;create env, agent, driver, monitor,&lt;br&gt;scoreboard, coverage; get vif from config_db&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="55" width="300" height="60" as="geometry"/></mxCell>
<mxCell id="c" value="&lt;b&gt;connect_phase&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;monitor ap -&amp;gt; scoreboard, coverage;&lt;br&gt;driver &amp;lt;-&amp;gt; sequencer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="145" width="300" height="55" as="geometry"/></mxCell>
<mxCell id="r" value="&lt;b&gt;run_phase: raise objection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;reset released after 20 ns&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="230" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;corner_case_seq&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;zero / max / low / high operands for each opcode,&lt;br&gt;SUB extremes, reserved opcodes 5, 6, 7&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="310" width="300" height="58" as="geometry"/></mxCell>
<mxCell id="dw" value="&lt;b&gt;WIDTH &amp;lt;= 8 ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="400" width="300" height="78" as="geometry"/></mxCell>
<mxCell id="ex" value="&lt;b&gt;exhaustive_seq&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;5 opcodes x 2^W x 2^W&lt;br&gt;(327,680 items at W = 8)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="230" height="70" as="geometry"/></mxCell>
<mxCell id="rn" value="&lt;b&gt;random_seq&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;dist-weighted operands per value class,&lt;br&gt;stops at 100 % coverage or 20,000 items&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="330" height="70" as="geometry"/></mxCell>
<mxCell id="dr" value="&lt;b&gt;drain the 1-cycle DUT pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;2 clocks + negedge so the last&lt;br&gt;two results reach scoreboard and coverage&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="530" width="300" height="65" as="geometry"/></mxCell>
<mxCell id="ck" value="&lt;b&gt;checks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;scoreboard checked &amp;gt; 0 ?&lt;br&gt;fail_count == 0 ?  coverage &amp;gt;= 95 % ?&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="625" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="er" value="&lt;b&gt;UVM_ERROR / UVM_WARNING&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;reported in the final UVM report&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="690" y="640" width="330" height="62" as="geometry"/></mxCell>
<mxCell id="dn" value="&lt;b&gt;drop objection&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="745" width="300" height="50" as="geometry"/></mxCell>
<mxCell id="rp" value="&lt;b&gt;report_phase / UVM report summary&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;counts by severity; scoreboard Total / Pass / Fail;&lt;br&gt;coverage %&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="825" width="300" height="70" as="geometry"/></mxCell>
<mxCell id="n" value="Verilator 5.052 compiles the covergroup and records every bin&amp;#x27;s hits in coverage.dat, but cg.get_coverage() returns 0.00 % and ignore_bins is not applied; the functional coverage reported in this project is computed&lt;br&gt;from coverage.dat by scripts/cov_uvm.py. Verilator&amp;#x27;s constraint solver also rejects the dist-weighted randomize() of random_seq; ext/uvm_ext.sv supplies a procedural equivalent selected by a UVM factory override." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="930" width="1212" height="31" as="geometry"/></mxCell>
