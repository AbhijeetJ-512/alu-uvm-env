<diagram id="uvm-environment-for-the-parameterised-alu---architecture" name="UVM environment for the parameterised ALU - architecture">
<mxGraphModel dx="1330" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1330" pageHeight="700" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="ga" value="agent  (is_active = UVM_ACTIVE, from alu_config)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="285" y="70" width="590" height="335" as="geometry"/></mxCell>
<mxCell id="seq" value="&lt;b&gt;Sequences&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;corner_case_seq&lt;br&gt;exhaustive_seq (WIDTH &amp;lt;= 8)&lt;br&gt;random_seq (WIDTH &amp;gt; 8)&lt;br&gt;(uvm_sequence#(transaction))&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="230" height="170" as="geometry"/></mxCell>
<mxCell id="sqr" value="&lt;b&gt;sequencer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;uvm_sequencer#(transaction)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="305" y="100" width="250" height="65" as="geometry"/></mxCell>
<mxCell id="drv" value="&lt;b&gt;driver&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;get_next_item, drive opcode,&lt;br&gt;num1, num2 on the vif, item_done&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="305" y="205" width="250" height="85" as="geometry"/></mxCell>
<mxCell id="mon" value="&lt;b&gt;monitor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;re-pairs each result with the&lt;br&gt;instruction driven one cycle&lt;br&gt;earlier (DUT latency = 1)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="605" y="205" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="if" value="&lt;b&gt;alu_if  (virtual interface)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;clk, rst_n, opcode, num1, num2, result, carry_out&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="305" y="440" width="550" height="55" as="geometry"/></mxCell>
<mxCell id="dut" value="&lt;b&gt;DUT: alu  (WIDTH parameter)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;ADD SUB AND OR XOR; reserved opcodes -&amp;gt; 0;&lt;br&gt;registered result and carry, one cycle of latency&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="305" y="545" width="550" height="110" as="geometry"/></mxCell>
<mxCell id="top" value="&lt;b&gt;testbench top  (alu_tb_top)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;generates clk and reset,&lt;br&gt;instantiates DUT and interface,&lt;br&gt;config_db::set(vif),&lt;br&gt;run_test(&amp;quot;test&amp;quot;)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="250" height="215" as="geometry"/></mxCell>
<mxCell id="sb" value="&lt;b&gt;scoreboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;uvm_analysis_imp&lt;br&gt;independent model: native + and -,&lt;br&gt;carry = (a &amp;gt;= b) for SUB; counts pass / fail&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="930" y="100" width="380" height="120" as="geometry"/></mxCell>
<mxCell id="cov" value="&lt;b&gt;coverage  (uvm_subscriber)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;covergroup: op_cp, num1_cp, num2_cp, carry_cp,&lt;br&gt;op x operands, op x carry&lt;br&gt;value classes zero / low / high / max&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="930" y="260" width="380" height="120" as="geometry"/></mxCell>
<mxCell id="n" value="The monitor publishes each complete&lt;br&gt;transaction through ONE analysis port;&lt;br&gt;the scoreboard checks it, the coverage&lt;br&gt;subscriber samples it." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="930" y="410" width="242.08" height="61" as="geometry"/></mxCell>
<mxCell id="n2" value="Sequences generate transactions, the driver applies them through the virtual interface, the monitor observes inputs and outputs, and the environment checks and measures what it observed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="675" width="1049.6" height="18.5" as="geometry"/></mxCell>
